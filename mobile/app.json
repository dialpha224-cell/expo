{
  "expo": {
    "name": "AfroCrown",
    "slug": "afrocrown-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afrocrown.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "AfroCrown utilise la caméra pour la simulation de coupe de cheveux avec IA",
        "NSPhotoLibraryUsageDescription": "AfroCrown accède à vos photos pour la simulation de coupe avec IA",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.afrocrown.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "afrocrown",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFD700"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AfroCrown accède à vos photos pour la simulation IA de coiffure",
          "cameraPermission": "AfroCrown utilise la caméra pour prendre des photos et simuler des coiffures"
        }
      ]
    ],
    "locales": {
      "fr": "./locales/fr.json"
    },
    "extra": {
      "apiUrl": "https://salon-dashboard-48.preview.emergentagent.com/api",
      "eas": {
        "projectId": "afrocrown-mobile"
      }
    },
    "owner": "afrocrown",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/afrocrown-mobile"
    }
  }
}
